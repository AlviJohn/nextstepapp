# Local dev works with none of these set (SQLite + demo billing).

# Postgres (Neon via Vercel Marketplace sets DATABASE_URL automatically)
DATABASE_URL=

# Required in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Google Sign-In (OAuth 2.0 "Web application" client ID)
GOOGLE_CLIENT_ID=

# Razorpay Subscriptions (leave blank to keep demo billing locally)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_INR_MONTHLY=
RAZORPAY_PLAN_INR_YEARLY=
RAZORPAY_PLAN_USD_MONTHLY=
RAZORPAY_PLAN_USD_YEARLY=
